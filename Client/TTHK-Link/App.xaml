<?xml version="1.0" encoding="utf-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TTHK_Link.App">

    <Application.Resources>
        <ResourceDictionary>

            <!-- TTHK COLORS -->
            <Color x:Key="PrimaryColor">#B61E2E</Color>
            <Color x:Key="PrimaryDarkColor">#9E1A28</Color>
            <Color x:Key="AccentColor">#B61E2E</Color>

            <!-- Base -->
            <Color x:Key="PageBackgroundColor">#F6F7FB</Color>
            <Color x:Key="PrimaryTextColor">#111111</Color>
            <Color x:Key="SecondaryTextColor">#6B7280</Color>
            <Color x:Key="BorderColor">#E5E7EB</Color>
            <Color x:Key="CardColor">#FFFFFF</Color>

            <!-- Default page -->
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource PageBackgroundColor}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <!-- Typography -->
            <Style x:Key="H1" TargetType="Label">
                <Setter Property="TextColor"
                        Value="{StaticResource PrimaryTextColor}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="Sub" TargetType="Label">
                <Setter Property="TextColor"
                        Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- Card -->
            <Style x:Key="Card" TargetType="Frame">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource CardColor}" />
                <Setter Property="BorderColor"
                        Value="{StaticResource BorderColor}" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>

            <!-- Input -->
            <Style x:Key="Input" TargetType="Entry">
                <Setter Property="TextColor"
                        Value="{StaticResource PrimaryTextColor}" />
                <Setter Property="PlaceholderColor"
                        Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="BackgroundColor"
                        Value="{StaticResource CardColor}" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <!-- Buttons -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource PrimaryColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="OutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor"
                        Value="{StaticResource PrimaryColor}" />
                <Setter Property="BorderColor"
                        Value="{StaticResource BorderColor}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>