<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="AppBg">#0B1220</Color>
    <Color x:Key="Surface">#111A2B</Color>
    <Color x:Key="Surface2">#16233A</Color>
    <Color x:Key="Text">#EAF0FF</Color>
    <Color x:Key="Muted">#AAB6D6</Color>
    <Color x:Key="Accent">#6C7CFF</Color>
    <Color x:Key="Border">#243454</Color>

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource AppBg}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource Text}"/>
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource Muted}"/>
    </Style>

    <Style x:Key="Card" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

</ResourceDictionary>