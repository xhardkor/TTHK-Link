<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TTHK_Link.Pages.ChatPage">

    <Grid Padding="10" RowDefinitions="*,Auto" RowSpacing="10">

        <CollectionView Grid.Row="0" ItemsSource="{Binding Items}" Margin="0,0,0,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="6">
                        <Frame Padding="10"
                               CornerRadius="18"
                               HasShadow="False"
                               MaximumWidthRequest="280"
                               HorizontalOptions="{Binding IsMine, Converter={StaticResource BoolToAlignmentConverter}}"
                               BackgroundColor="{Binding IsMine, Converter={StaticResource BoolToBubbleColorConverter}}">
                            <VerticalStackLayout Spacing="4">
                                <!-- Имя показываем только если НЕ моё -->
                                <Label Text="{Binding SenderName}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       IsVisible="{Binding IsMine, Converter={StaticResource InverseBoolConverter}}" />

                                <Label Text="{Binding Msg}"
                                       FontSize="15"
                                       TextColor="{Binding IsMine, Converter={StaticResource BoolToTextColorConverter}}"/>

                                <Label Text="{Binding CreatedAt, StringFormat='{0:HH:mm}'}"
                                       FontSize="10"
                                       Opacity="0.6"
                                       HorizontalOptions="End"
                                       TextColor="{Binding IsMine, Converter={StaticResource BoolToTimeColorConverter}}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Sisestus + nupp -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Entry Grid.Column="0"
                   Placeholder="Kirjuta sõnum…"
                   Text="{Binding NewMessageText}"
                   ReturnType="Send"
                   ReturnCommand="{Binding SendMessageCommand}" />

            <Button Grid.Column="1"
                    Text="Saada"
                    Command="{Binding SendMessageCommand}"
                    IsEnabled="{Binding CanSendMessage}" />
        </Grid>

    </Grid>
</ContentPage>
