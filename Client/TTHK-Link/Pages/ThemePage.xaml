<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TTHK_Link.Pages.ThemePage"
    Title="Оформление"
    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0B1424}">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Label Text="Переключатель темы."
               FontSize="18"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

        <Button Text="LIGHT"
                HeightRequest="52"
                CornerRadius="14"
                BackgroundColor="#5A36F0"
                TextColor="White"
                Clicked="OnTestLight" />

        <Button Text="DARK"
                HeightRequest="52"
                CornerRadius="14"
                BackgroundColor="#5A36F0"
                TextColor="White"
                Clicked="OnTestDark" />

    </VerticalStackLayout>
</ContentPage>