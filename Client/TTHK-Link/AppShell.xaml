<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TTHK_Link.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TTHK_Link.Pages"
    Title="TTHK_Link"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="#0F1B2D">

    <!-- Профиль сверху (как в Telegram) -->
    <Shell.FlyoutHeader>
        <Grid Padding="18" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Frame WidthRequest="56" HeightRequest="56"
                   CornerRadius="28"
                   HasShadow="False"
                   BackgroundColor="#1E2A3D"
                   Padding="0">
                <Label Text="{Binding ProfileInitials}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Frame>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="{Binding FullName}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White"/>
                <Label Text="{Binding GroupName}"
                       FontSize="13"
                       Opacity="0.8"
                       TextColor="White"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Экраны в меню -->
    <FlyoutItem Title="Группы" Route="groups">
        <ShellContent ContentTemplate="{DataTemplate pages:CoursePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Чат" Route="chat">
        <ShellContent ContentTemplate="{DataTemplate pages:ChatPage}" />
    </FlyoutItem>

    <!-- Логин НЕ добавляем в меню, оставляем только как маршрут -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate pages:LoginPage}" />

</Shell>