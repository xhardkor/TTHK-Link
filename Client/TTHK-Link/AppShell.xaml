<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TTHK_Link.AppShell"
    x:Name="AppShellRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TTHK_Link.Pages"
    xmlns:conv="clr-namespace:TTHK_Link.Converters"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="#0F1B2D"
    BackgroundColor="#0B1424"
    Shell.NavBarHasShadow="False"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White">

    <Shell.Resources>
        <ResourceDictionary>
            <conv:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter"/>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- ====== КАСТОМНОЕ МЕНЮ ====== -->
    <Shell.FlyoutContent>
        <Grid
            BindingContext="{Binding Source={x:Reference AppShellRoot}, Path=BindingContext}"
            BackgroundColor="#0F1B2D"
            RowDefinitions="Auto,*,Auto">

            <!-- Header (профиль) -->
            <Grid Padding="18" ColumnDefinitions="Auto,*" ColumnSpacing="14" BackgroundColor="#0B1424">
                <Frame WidthRequest="56" HeightRequest="56"
                       CornerRadius="28"
                       HasShadow="False"
                       BackgroundColor="#1E2A3D"
                       Padding="0">
                    <Grid>
                        <Image Source="{Binding AvatarUrl}"
                               Aspect="AspectFill"
                               IsVisible="{Binding AvatarUrl, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>

                        <Label Text="{Binding ProfileInitials}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding AvatarUrl, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                                             Value="True">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </Frame>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding FullName}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="{Binding GroupName}" FontSize="13" TextColor="#9FB0C8"/>
                </VerticalStackLayout>

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                </Grid.GestureRecognizers>
            </Grid>

            <BoxView HeightRequest="1" Color="#1E2A3D" />

            <!-- Menu list -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None"
                            Margin="0,8,0,8">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6,0">
                            <Frame Padding="0"
                                   CornerRadius="14"
                                   HasShadow="False"
                                   BackgroundColor="Transparent">

                                <Grid Padding="14,10" ColumnDefinitions="24,*,Auto" ColumnSpacing="12">

                                    <Image Source="{Binding Icon}" WidthRequest="22" HeightRequest="22" Opacity="0.95" />

                                    <Label Grid.Column="1"
                                           Text="{Binding Title}"
                                           TextColor="White"
                                           FontSize="16"
                                           VerticalTextAlignment="Center" />

                                    <Frame Grid.Column="2"
                                           IsVisible="{Binding Badge, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                                           Padding="8,2"
                                           CornerRadius="10"
                                           HasShadow="False"
                                           BackgroundColor="#2A7FFF"
                                           VerticalOptions="Center">
                                        <Label Text="{Binding Badge}" TextColor="White" FontSize="12"/>
                                    </Frame>

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.OpenCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Logout -->
            <Grid Grid.Row="2" Padding="14,10">
                <Button Text="Выйти"
                        BackgroundColor="#1E2A3D"
                        TextColor="White"
                        CornerRadius="14"
                        Command="{Binding LogoutCommand}" />
            </Grid>

        </Grid>
    </Shell.FlyoutContent>

    <!-- ====== РОУТЫ (экраны) ====== -->
    <!-- ====== РОУТЫ (экраны) ====== -->
    <FlyoutItem Title="Новости" Route="news" FlyoutItemIsVisible="False">
        <ShellContent Route="news"
                      ContentTemplate="{DataTemplate pages:NewsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Чаты" Route="chatlist" FlyoutItemIsVisible="False">
        <ShellContent Route="chatlist"
                      ContentTemplate="{DataTemplate pages:ChatListPage}" />
    </FlyoutItem>

    <!-- Диалог (не в меню), открывается по параметрам -->
    <ShellContent Route="chat"
                  FlyoutItemIsVisible="False"
                  ContentTemplate="{DataTemplate pages:ChatPage}" />

    <ShellContent Route="login"
                  FlyoutItemIsVisible="False"
                  ContentTemplate="{DataTemplate pages:LoginPage}"/>
    
    <FlyoutItem Title="О приложении" Route="about">
        <ShellContent ContentTemplate="{DataTemplate pages:AboutPage}" />
    </FlyoutItem>
    
    <FlyoutItem Title="Оформление" Route="theme" FlyoutItemIsVisible="False">
        <ShellContent Route="theme"
                      ContentTemplate="{DataTemplate pages:ThemePage}" />
    </FlyoutItem>
    
</Shell>
                  
       